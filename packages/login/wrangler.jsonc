{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reader-cloudflare-login",
  "main": "src/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "LOGIN_ORIGIN": "http://localhost:8791",
    "READER_ORIGIN": "http://localhost:8790",
    "LOGIN_OIDC_CLIENT_ID": "reader-cloudflare-access",
    "EMAIL_SENDER": "login@remit.test",
    "OPERATOR_EMAILS": "operator@remit.test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reader-cloudflare-login",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@remit.test"]
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "LOGIN_AUTH_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "LOGIN_AUTH_SECRET"
    },
    {
      "binding": "LOGIN_OIDC_CLIENT_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "LOGIN_OIDC_CLIENT_SECRET"
    }
  ],
  "env": {
    "e2e": {
      "build": {
        "command": "npm run build"
      },
      "routes": [],
      "vars": {
        "LOGIN_ORIGIN": "http://127.0.0.1:8791",
        "READER_ORIGIN": "http://127.0.0.1:8790",
        "LOGIN_OIDC_CLIENT_ID": "reader-cloudflare-access",
        "EMAIL_SENDER": "login@remit.test",
        "OPERATOR_EMAILS": "operator@remit.test"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reader-cloudflare-login",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["login@remit.test"]
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "LOGIN_AUTH_SECRET",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "LOGIN_AUTH_SECRET"
        },
        {
          "binding": "LOGIN_OIDC_CLIENT_SECRET",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "LOGIN_OIDC_CLIENT_SECRET"
        }
      ]
    }
  }
}

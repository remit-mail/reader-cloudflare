{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reader-cloudflare",
  "main": "src/index.ts",
  "alias": {
    "ajv": "./src/build/unused/ajv.ts",
    "openapi-schema-validator": "./src/build/unused/openapi-schema-validator.ts",
    "socks": "./src/build/unused/socks.ts"
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/content/*",
      "/outbox-upload/*",
      "/mcp",
      "/mcp/*",
      "/.well-known/*",
      "/auth/*",
      "/consent",
      "/device",
      "/apps"
    ]
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "local",
    "PUBLIC_ORIGIN": "http://localhost:8790"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reader-cloudflare",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "reader-cloudflare-mail"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SYNC",
        "queue": "reader-cloudflare-sync"
      },
      {
        "binding": "MUTATION_QUEUE",
        "queue": "reader-cloudflare-mutation"
      },
      {
        "binding": "SMTP_QUEUE",
        "queue": "reader-cloudflare-smtp"
      },
      {
        "binding": "FANOUT_QUEUE",
        "queue": "reader-cloudflare-fanout"
      },
      {
        "binding": "BODY_QUEUE",
        "queue": "reader-cloudflare-body"
      }
    ],
    "consumers": [
      {
        "queue": "reader-cloudflare-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 2,
        "max_retries": 3,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-body",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-mutation",
        "max_batch_size": 10,
        "max_batch_timeout": 0,
        "max_retries": 2,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-smtp",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 2,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-fanout",
        "max_batch_size": 10,
        "max_batch_timeout": 0,
        "max_retries": 2,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-dlq",
        "max_batch_size": 5,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_MAIL",
        "class_name": "TenantMailV3"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TenantMail"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TenantSearch"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AccountSync"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["TenantSearch"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TenantMailV2", "AccountSyncV2"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["TenantMail", "AccountSync"]
    },
    {
      "tag": "v7",
      "deleted_classes": ["AccountSyncV2"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["TenantMailV3"]
    },
    {
      "tag": "v9",
      "deleted_classes": ["TenantMailV2"]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "ratelimits": [
    {
      "name": "TENANT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "CALENDAR_FEED_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "MASTER_KEY",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "MASTER_KEY"
    },
    {
      "binding": "MCP_AUTH_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "MCP_AUTH_SECRET"
    }
  ],
  "env": {
    "e2e": {
      "build": {
        "command": "npm run commit"
      },
      "assets": {
        "directory": "packages/web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/content/*", "/outbox-upload/*", "/__scheduled"]
      },
      "routes": [],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
        "ACCESS_AUD": "local",
        "PUBLIC_ORIGIN": "http://127.0.0.1:8790",
        "ACCESS_DEV_IDENTITY": "e2e@remit.test",
        "PLAINTEXT_MAIL_HOSTS": "127.0.0.1"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reader-cloudflare",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MAIL",
          "bucket_name": "reader-cloudflare-mail"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SYNC",
            "queue": "reader-cloudflare-sync"
          },
          {
            "binding": "MUTATION_QUEUE",
            "queue": "reader-cloudflare-mutation"
          },
          {
            "binding": "SMTP_QUEUE",
            "queue": "reader-cloudflare-smtp"
          },
          {
            "binding": "FANOUT_QUEUE",
            "queue": "reader-cloudflare-fanout"
          },
          {
            "binding": "BODY_QUEUE",
            "queue": "reader-cloudflare-body"
          }
        ],
        "consumers": [
          {
            "queue": "reader-cloudflare-sync",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_concurrency": 2,
            "max_retries": 3,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-body",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_concurrency": 1,
            "max_retries": 3,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-mutation",
            "max_batch_size": 10,
            "max_batch_timeout": 0,
            "max_retries": 2,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-smtp",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 2,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-fanout",
            "max_batch_size": 10,
            "max_batch_timeout": 0,
            "max_retries": 2,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-dlq",
            "max_batch_size": 5,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "TENANT_MAIL",
            "class_name": "TenantMailV3"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "TENANT_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 100000, "period": 60 }
        },
        {
          "name": "CALENDAR_FEED_RATE_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 100000, "period": 60 }
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "MASTER_KEY",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "MASTER_KEY"
        },
        {
          "binding": "MSOAUTH_CLIENT_SECRET",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "MSOAUTH_CLIENT_SECRET"
        },
        {
          "binding": "CLASSIFICATION_DEFAULT_API_KEY",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "CLASSIFICATION_DEFAULT_API_KEY"
        },
        {
          "binding": "MCP_AUTH_SECRET",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "MCP_AUTH_SECRET"
        }
      ]
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reader-cloudflare",
  "main": "src/index.ts",
  "build": {
    "command": "npm run db:migrate:build && npm run commit && npm run build"
  },
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/content/*"]
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "app.remit.email",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "stallion-app.cloudflareaccess.com",
    "ACCESS_AUD": "b06099dd8699373a9073e60ed78ca5d1bfff972808c1d5b46714f3b4ec567596",
    "PUBLIC_ORIGIN": "https://app.remit.email"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reader-cloudflare",
      "database_id": "b89e3e29-23ba-427b-95ae-cc4cd5c15167"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "reader-cloudflare-mail"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SYNC",
        "queue": "reader-cloudflare-sync"
      },
      {
        "binding": "MUTATION_QUEUE",
        "queue": "reader-cloudflare-mutation"
      },
      {
        "binding": "SMTP_QUEUE",
        "queue": "reader-cloudflare-smtp"
      },
      {
        "binding": "FANOUT_QUEUE",
        "queue": "reader-cloudflare-fanout"
      }
    ],
    "consumers": [
      {
        "queue": "reader-cloudflare-sync",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-mutation",
        "max_batch_size": 10,
        "max_retries": 2,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-smtp",
        "max_batch_size": 1,
        "max_retries": 2,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-fanout",
        "max_batch_size": 10,
        "max_retries": 2,
        "dead_letter_queue": "reader-cloudflare-dlq"
      },
      {
        "queue": "reader-cloudflare-dlq",
        "max_batch_size": 5,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_MAIL",
        "class_name": "TenantMailV3"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TenantMail"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TenantSearch"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AccountSync"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["TenantSearch"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TenantMailV2", "AccountSyncV2"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["TenantMail", "AccountSync"]
    },
    {
      "tag": "v7",
      "deleted_classes": ["AccountSyncV2"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["TenantMailV3"]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "MASTER_KEY",
      "store_id": "0376668ade8548e5a44a2d63d0a7f537",
      "secret_name": "MASTER_KEY"
    }
  ],
  "env": {
    "e2e": {
      "build": {
        "command": "npm run commit"
      },
      "routes": [],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "stallion-app.cloudflareaccess.com",
        "ACCESS_AUD": "b06099dd8699373a9073e60ed78ca5d1bfff972808c1d5b46714f3b4ec567596",
        "PUBLIC_ORIGIN": "http://127.0.0.1:8790",
        "ACCESS_DEV_IDENTITY": "e2e@remit.test",
        "PLAINTEXT_MAIL_HOSTS": "127.0.0.1"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reader-cloudflare",
          "database_id": "b89e3e29-23ba-427b-95ae-cc4cd5c15167"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MAIL",
          "bucket_name": "reader-cloudflare-mail"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SYNC",
            "queue": "reader-cloudflare-sync"
          },
          {
            "binding": "MUTATION_QUEUE",
            "queue": "reader-cloudflare-mutation"
          },
          {
            "binding": "SMTP_QUEUE",
            "queue": "reader-cloudflare-smtp"
          },
          {
            "binding": "FANOUT_QUEUE",
            "queue": "reader-cloudflare-fanout"
          }
        ],
        "consumers": [
          {
            "queue": "reader-cloudflare-sync",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-mutation",
            "max_batch_size": 10,
            "max_retries": 2,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-smtp",
            "max_batch_size": 1,
            "max_retries": 2,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-fanout",
            "max_batch_size": 10,
            "max_retries": 2,
            "dead_letter_queue": "reader-cloudflare-dlq"
          },
          {
            "queue": "reader-cloudflare-dlq",
            "max_batch_size": 5,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "TENANT_MAIL",
            "class_name": "TenantMailV3"
          }
        ]
      },
      "secrets_store_secrets": [
        {
          "binding": "MASTER_KEY",
          "store_id": "0376668ade8548e5a44a2d63d0a7f537",
          "secret_name": "MASTER_KEY"
        }
      ]
    }
  }
}

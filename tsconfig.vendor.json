{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "node_modules/@remit",
    "outDir": ".types",
    "types": ["node"],
    "esModuleInterop": true,
    "noCheck": true
  },
  "include": [
    "node_modules/@remit/config-transfer/src",
    "node_modules/@remit/config-format/src",
    "node_modules/@remit/drizzle-service/src",
    "node_modules/@remit/mail-oauth-service/src",
    "node_modules/@remit/secrets-service/src",
    "node_modules/@remit/smtp-service/src",
    "node_modules/@remit/smtp-worker/src"
  ],
  "exclude": [
    "node_modules/@remit/*/src/**/*.test.ts",
    "node_modules/@remit/*/src/conformance",
    "node_modules/@remit/*/src/bin"
  ]
}

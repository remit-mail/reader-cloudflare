{
  "name": "reader-cloudflare",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8790",
    "tail": "node npm-scripts/wrangler.mjs tail --format pretty",
    "deploy": "node npm-scripts/deploy.mjs",
    "fix": "biome check --write .",
    "check": "biome check .",
    "typecheck": "npm run commit && npm run build:schema && npm run build:vendor-types && tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p npm-scripts/tsconfig.json && tsc --noEmit -p packages/login/tsconfig.json && tsc --noEmit -p packages/login/web/tsconfig.json",
    "infra:plan": "node npm-scripts/infra.mjs",
    "cf-env:write": "node npm-scripts/cf-env-write.mjs",
    "ci": "npm run check && npm run check:no-config && npm run check:retries && npm run typecheck && npm run test",
    "check:retries": "node npm-scripts/check-retries.mjs",
    "check:no-config": "node npm-scripts/check-no-config.mjs",
    "commit": "node npm-scripts/commit.mjs",
    "db:generate": "npm run build:schema && drizzle-kit generate",
    "db:generate:mail": "drizzle-kit generate --config drizzle.mail.config.ts",
    "db:generate:search": "drizzle-kit generate --config drizzle.search.config.ts",
    "db:migrate": "node npm-scripts/db-migrate.mjs",
    "wrangler": "node npm-scripts/wrangler.mjs",
    "build": "npm run commit && npm run build:schema && npm run build --workspace packages/web && npm run build:mcp-pages",
    "build:mcp-pages": "tsx npm-scripts/mcp-pages.ts",
    "generate": "tsp format \"typespec/**/*.tsp\" \"packages/login/typespec/**/*.tsp\" && tsp compile ./typespec && tsp compile ./packages/login/typespec && biome check --write packages/app-db-schema packages/login-db-schema",
    "build:schema": "npm run build --workspace app-db-schema && npm run build --workspace login-db-schema",
    "build:vendor-types": "tsc -p tsconfig.vendor.json",
    "smoke:config-import": "node npm-scripts/smoke-config-import.mjs",
    "logs": "node npm-scripts/logs.mjs",
    "builds": "node npm-scripts/builds.mjs list",
    "builds:log": "node npm-scripts/builds.mjs log",
    "builds:retry": "node npm-scripts/builds-retry.mjs",
    "e2e": "node npm-scripts/e2e.mjs",
    "e2e:login": "node npm-scripts/e2e-login.mjs",
    "dashboards": "node npm-scripts/dashboards.mjs",
    "access-env:write": "node npm-scripts/access-env-write.mjs",
    "api": "node npm-scripts/api.mjs",
    "mcp:login": "tsx npm-scripts/mcp-login.ts",
    "login:mail": "node npm-scripts/login-mail.mjs",
    "smoke:sync": "node npm-scripts/smoke-sync.mjs",
    "seed:dev": "tsx npm-scripts/seed-dev.ts",
    "smoke:dev": "tsx npm-scripts/smoke-dev.ts",
    "test": "npm run build:schema && npm run test --workspace login",
    "db:generate:login": "npm run build:schema && npm run db:generate --workspace login"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@kattebak/typespec-drizzle-orm-generator": "^6.3.1",
    "@typespec/compiler": "^1.17.0",
    "drizzle-kit": "1.0.0-rc.5",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typespec-electrodb-emitter": "^6.0.1",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@remit/account-worker": "1.4.8",
    "@remit/api-http-client": "0.0.109",
    "@remit/api-openapi-spec": "0.0.110",
    "@remit/api-openapi-types": "0.0.114",
    "@remit/backend": "5.12.1",
    "@remit/calendar-service": "1.0.35",
    "@remit/config-format": "0.3.11",
    "@remit/config-transfer": "0.2.12",
    "@remit/data-ports": "2.13.1",
    "@remit/domain-enums": "0.0.60",
    "@remit/drizzle-service": "3.9.1",
    "@remit/drizzle-sqlite-schema": "0.0.69",
    "@remit/imap-worker": "3.6.1",
    "@remit/logger": "0.2.0",
    "@remit/mail-oauth-service": "0.0.37",
    "@remit/mailbox-service": "2.27.0",
    "@remit/mcp-server": "0.14.5",
    "@remit/secrets-service": "0.0.13",
    "@remit/smtp-service": "1.0.34",
    "@remit/smtp-worker": "2.0.17",
    "@remit/storage-service": "0.0.46",
    "app-db-schema": "0.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "imapflow": "^2.9.1",
    "nodemailer": "^10.2.1",
    "openapi-backend": "^5.22.0",
    "uuid": "^9.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "follow-redirects": "1.16.2",
    "short-uuid": "6.0.3"
  }
}

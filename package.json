{
  "name": "reader-cloudflare",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8790",
    "tail": "node npm-scripts/wrangler.mjs tail --format pretty",
    "deploy": "node npm-scripts/deploy.mjs",
    "fix": "biome check --write .",
    "check": "biome check .",
    "typecheck": "npm run commit && npm run build:schema && npm run build:vendor-types && tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p packages/web/tsconfig.json",
    "infra:plan": "node npm-scripts/infra.mjs plan",
    "infra:apply": "node npm-scripts/infra.mjs apply",
    "cf-env:write": "node npm-scripts/cf-env-write.mjs",
    "cf-env:bootstrap-move": "node npm-scripts/cf-env-bootstrap-move.mjs",
    "ci": "npm run check && npm run check:retries && npm run typecheck",
    "check:retries": "node npm-scripts/check-retries.mjs",
    "commit": "node npm-scripts/commit.mjs",
    "db:generate": "npm run build:schema && drizzle-kit generate",
    "db:generate:mail": "drizzle-kit generate --config drizzle.mail.config.ts",
    "db:generate:search": "drizzle-kit generate --config drizzle.search.config.ts",
    "db:migrate": "node npm-scripts/db-migrate.mjs",
    "wrangler": "node npm-scripts/wrangler.mjs",
    "build": "npm run commit && npm run build:schema && npm run build --workspace packages/web",
    "generate": "tsp format \"typespec/**/*.tsp\" && tsp compile ./typespec && biome check --write packages/app-db-schema",
    "build:schema": "npm run build --workspace app-db-schema",
    "build:vendor-types": "tsc -p tsconfig.vendor.json",
    "smoke:config-import": "node npm-scripts/smoke-config-import.mjs",
    "logs": "node npm-scripts/logs.mjs",
    "e2e": "node npm-scripts/e2e.mjs",
    "dashboards": "node npm-scripts/dashboards.mjs",
    "access-env:write": "node npm-scripts/access-env-write.mjs",
    "api": "node npm-scripts/api.mjs",
    "smoke:sync": "node npm-scripts/smoke-sync.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@kattebak/typespec-drizzle-orm-generator": "^6.1.0",
    "@typespec/compiler": "^1.17.0",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "typespec-electrodb-emitter": "^6.0.1",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@remit/account-worker": "0.0.32",
    "@remit/api-http-client": "0.0.78",
    "@remit/api-openapi-spec": "0.0.79",
    "@remit/api-openapi-types": "0.0.82",
    "@remit/backend": "0.0.149",
    "@remit/config-format": "0.0.8",
    "@remit/config-transfer": "0.0.13",
    "@remit/data-ports": "0.0.89",
    "@remit/domain-enums": "0.0.29",
    "@remit/drizzle-service": "0.0.105",
    "@remit/drizzle-sqlite-schema": "0.0.36",
    "@remit/imap-worker": "0.0.92",
    "@remit/logger": "0.0.2",
    "@remit/mailbox-service": "0.0.117",
    "@remit/secrets-service": "0.0.11",
    "@remit/smtp-service": "0.0.20",
    "@remit/smtp-worker": "0.0.31",
    "@remit/storage-service": "0.0.13",
    "app-db-schema": "0.0.0",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.9.1",
    "nodemailer": "^10.2.1",
    "openapi-backend": "^5.22.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "short-uuid": "^6.0.3"
  }
}

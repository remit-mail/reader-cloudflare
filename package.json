{
  "name": "reader-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8790",
    "tail": "wrangler tail --format pretty",
    "deploy": "node npm-scripts/deploy.mjs",
    "fix": "biome check --write .",
    "check": "biome check .",
    "typecheck": "npm run commit && tsc --noEmit -p tsconfig.json",
    "infra:plan": "node npm-scripts/infra.mjs plan",
    "infra:apply": "node npm-scripts/infra.mjs apply",
    "ci": "npm run check && npm run typecheck",
    "commit": "node npm-scripts/commit.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:mail": "drizzle-kit generate --config drizzle.mail.config.ts",
    "db:generate:search": "drizzle-kit generate --config drizzle.search.config.ts",
    "db:migrate": "node npm-scripts/db-migrate.mjs",
    "wrangler": "node npm-scripts/wrangler.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/workers-types": "^5.20261024.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@remit/drizzle-sqlite-schema": "^0.0.34",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.9.1",
    "nodemailer": "^10.2.1",
    "postal-mime": "^4.1.4",
    "zod": "^4.6.7"
  }
}
